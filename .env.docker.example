APP_NAME=HoneyCommerce
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_SEED_DEMO=true
INERTIA_SSR_ENABLED=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=honeycommerce
DB_USERNAME=honeycommerce
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false

CACHE_STORE=redis
QUEUE_CONNECTION=redis
FILESYSTEM_DISK=public

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

LOG_CHANNEL=stderr
LOG_LEVEL=info
MAIL_MAILER=log
MAIL_LOG_CHANNEL=stderr
MAIL_FROM_ADDRESS="demo@example.test"
MAIL_FROM_NAME="HoneyCommerce Demo"

COMMERCE_USE_BUILT_ASSETS=true
COMMERCE_CONTACT=
COMMERCE_SHIPPING_FLAT_IDR=20000
COMMERCE_PAYMENT_INSTRUCTIONS="Pembayaran simulasi lokal. Jangan transfer uang sungguhan."
AUTH_LOCAL_TESTING_BYPASS=false
BOOST_BROWSER_LOGS_WATCHER=false
DEMO_PASSWORD=demo12345

DOCKER_HTTP_BIND=127.0.0.1
DOCKER_HTTP_PORT=8000
