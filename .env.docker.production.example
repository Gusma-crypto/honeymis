APP_NAME=HoneyCommerce
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Use the actual domain. Enable SESSION_SECURE_COOKIE after configuring HTTPS.
APP_URL=http://YOUR_SERVER_IP
APP_SEED_DEMO=false
INERTIA_SSR_ENABLED=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=honeycommerce
DB_USERNAME=honeycommerce
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_QUEUE_RETRY_AFTER=90
FILESYSTEM_DISK=public

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

LOG_CHANNEL=stderr
LOG_LEVEL=info
# Configure SMTP before enabling real email delivery.
MAIL_MAILER=log
MAIL_LOG_CHANNEL=stderr
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=admin@example.com
MAIL_FROM_NAME="${APP_NAME}"

COMMERCE_USE_BUILT_ASSETS=true
COMMERCE_CONTACT=
COMMERCE_SHIPPING_FLAT_IDR=20000
COMMERCE_PAYMENT_INSTRUCTIONS="Hubungi pengelola toko untuk rekening transfer resmi."
AUTH_LOCAL_TESTING_BYPASS=false
BOOST_BROWSER_LOGS_WATCHER=false

DOCKER_HTTP_BIND=0.0.0.0
DOCKER_HTTP_PORT=80
